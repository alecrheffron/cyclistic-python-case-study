      <aliases enabled='yes' />
      <column caption='Calculation1' datatype='real' name='[Calculation_0447816284577792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='' />
      </column>
      <column caption='Casual Rider %' datatype='real' name='[Calculation_0447816284631041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [rider_type] = &quot;Casual Rider&quot; THEN 1&#10;    ELSE 0&#10;    END)&#10;/&#10;COUNT([trip_id])' />
      </column>
      <column caption='Calculation2' datatype='real' name='[Calculation_0447816617467906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;    IF [rider_type] = &quot;Casual Rider&quot;&#10;    THEN [trip_duration_minutes]&#10;    END&#10;)&#10;/&#10;AVG(&#10;    IF [rider_type] = &quot;Annual Member&quot;&#10;    THEN [trip_duration_minutes]&#10;    END&#10;)' />
      </column>
      <column caption='Casual Trip Duration Ratio' datatype='real' name='[Calculation_0447816617558019]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;    IF [rider_type] = &quot;Casual Rider&quot;&#10;    THEN [trip_duration_minutes]&#10;    END&#10;)&#10;/&#10;AVG(&#10;    IF [rider_type] = &quot;Annual Member&quot;&#10;    THEN [trip_duration_minutes]&#10;    END&#10;)' />
      </column>
